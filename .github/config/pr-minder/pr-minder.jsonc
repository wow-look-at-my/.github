{
	"$schema": "https://sites.pazer.build/webhooks/branch/master/pr-minder.schema.json",
	"auto_label_pr": {
		"auto-pr-update": {
			"mode": "auto_update",
			"auto_add": "on_pr_creation",
			"create_label_if_missing_in_repo": true,
			"color": "00ff00"
		},
		"auto-pr-merge": {
			"mode": "auto_merge",
			"create_label_if_missing_in_repo": true,
			"color": "0075ca"
		},
		"merge-conflict": {
			"mode": "merge_conflict",
			"create_label_if_missing_in_repo": true,
			"color": "b60205"
		},
		"auto-pr-resolve": {
			// Sticky AI merge-conflict-resolution lease (pr-minder mode: "auto_resolve",
			// handled by the pr-resolve webhook-runner hook): the label stays on, and
			// pr-minder re-triggers a resolve run whenever the PR is conflicted (one
			// attempt per head SHA). A push to the head branch by anyone other than
			// pr-minder itself stands it down -- run cancelled, label removed, one
			// standdown comment -- until the label is re-added (webhooks PR 100).
			"mode": "auto_resolve",
			"create_label_if_missing_in_repo": true,
			"color": "8250df"
		}
	},
	"auto_trigger_workflows": true,
	"auto_open_pr": {
		"enabled": true,
		"base_from_fork_point": false, // always open auto-PRs against the repo's default branch, never a detected fork-point base
		"skip_branch_patterns": ["^\\d+\\.\\d+(\\.\\d+)?$", "^\\d+\\.\\d+(\\.\\d+)?-", "^releases?/", "^dev-", "^v\\d+\\.\\d+", "^users/", "^revert-\\d+-"]
	},
	"auto_describe_pr": {
		"enabled": true
	},
	// Per-repo overrides: pr-minder merges repos.{repo} field-wise over the
	// top-level defaults above (only meaningful in this org-level file).
	"repos": {
		// UnrealEngine is a fork of a giant upstream. An explicit per-repo
		// auto_open_pr.enabled: true sets AutoOpenPr.enabledPerRepo (config.ts:
		// "true only when an EXPLICIT per-repo config source set enabled: true"),
		// which is an outright BYPASS of the fork guard (handlers.ts: the
		// p.repository.fork === true && !enabledPerRepo check is skipped). With
		// the guard bypassed, pr-minder opens PRs for every non-default,
		// non-skipped branch WITHOUT checking whether the branch also exists
		// upstream -- so skip_branch_patterns must carry the upstream branch
		// families (staging-*, ue5-*, promoted, release-engine-*, master) that
		// the per-branch guard (webhooks PR 211, forkBranchOrigin) would have
		// skipped as inherited. The top-level patterns are repeated here because
		// mergeConfig replaces (not appends) skip_branch_patterns from the
		// override slot.
		"UnrealEngine": {
			"auto_open_pr": {
				"enabled": true,
				"skip_branch_patterns": ["^\\d+\\.\\d+(\\.\\d+)?$", "^\\d+\\.\\d+(\\.\\d+)?-", "^releases?/", "^dev-", "^v\\d+\\.\\d+", "^users/", "^revert-\\d+-", "^staging-", "^ue4-", "^ue5-", "^promoted$", "^release-engine-", "^master$"]
			}
		},
		// gcc is a fork of the giant upstream GCC mirror. Same explicit per-repo
		// enable: auto_open_pr.enabled: true sets enabledPerRepo, bypassing the
		// per-branch fork guard. skip_branch_patterns carries gcc's upstream
		// branch families (devel/*, trunk, master) plus the top-level patterns
		// (repeated because mergeConfig replaces, not appends).
		"gcc": {
			"auto_open_pr": {
				"enabled": true,
				"skip_branch_patterns": ["^\\d+\\.\\d+(\\.\\d+)?$", "^\\d+\\.\\d+(\\.\\d+)?-", "^releases?/", "^dev-", "^v\\d+\\.\\d+", "^users/", "^revert-\\d+-", "^devel/", "^trunk$", "^master$"]
			}
		},
		// Merge-train CANARY. Per-repo on purpose: a top-level merge_train
		// arms the whole fleet at once, and this feature has never run against
		// production traffic. webhooks pays the most for the legacy flow
		// (~N(N-1)/2 full builds to land N armed PRs), so it gains the most.
		"webhooks": {
			"merge_train": {
				"enabled": true
			}
		},
		// Merge-train pilot (webhooks#164/#165/#166).
		"github-state-mirror": {
			"merge_train": {
				"enabled": true
			}
		}
	}
}
