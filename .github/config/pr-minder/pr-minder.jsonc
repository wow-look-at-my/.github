{
	"$schema": "https://raw.githubusercontent.com/wow-look-at-my/pr-minder/master/schema/pr-minder.schema.json",
	"auto_label_pr": {
		"auto-pr-update": {
			"mode": "auto_update",
			"auto_add": "on_pr_creation",
			"create_label_if_missing_in_repo": true,
			"color": "00ff00"
		},
		"auto-pr-merge": {
			"mode": "auto_merge",
			"create_label_if_missing_in_repo": true,
			"color": "0075ca"
		},
		"merge-conflict": {
			"mode": "merge_conflict",
			"create_label_if_missing_in_repo": true,
			"color": "b60205"
		}
	},
	"auto_trigger_workflows": true,
	"auto_open_pr": {
		"enabled": false
	},
	"auto_describe_pr": {
		"enabled": false
	}
}
